# Listen once and transcribe (same work as /stt_service, with timeout, feedback and cancellation)

# Goal
float32 max_wait  # Seconds to wait for the person to start speaking (0 = server default)
---
# Result
bool success
bool timed_out    # True if nobody started speaking within max_wait
string text       # Transcription (also published on /listened_text)
string message
---
# Feedback
string status     # "listening", "speech_detected" or "transcribing"
