<?xml version="1.0"?>
<package format="3">
  <name>simple_hri_interfaces</name>
  <version>0.0.1</version>
  <description>Action and service interfaces of simple_hri: Listen, Say, Extract and YesNo</description>

  <maintainer email="rodrigo.perez@urjc.es">Rodrigo Pérez-Rodríguez</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>rosidl_default_generators</build_depend>
  <depend>action_msgs</depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>
